# ============================================================
#  TEMPLATE — jangan isi di file ini.
#
#  Buat salinannya dulu, lalu isi di file .env.local:
#    Copy-Item .env.local.example .env.local
#
#  Nilai didapat dari Supabase:
#    Project Settings -> API -> Project URL & anon public key
#
#  Catatan: .env.local sudah masuk .gitignore, jadi aman
#  (tidak akan ikut ter-upload ke GitHub).
# ============================================================

# Contoh: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Contoh: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Ambil yang namanya "anon public" / "publishable key", BUKAN service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
